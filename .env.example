# Supabase → Settings → API
VITE_PUBLIC_SUPABASE_URL=
VITE_PUBLIC_SUPABASE_ANON_KEY=

# Full URL allowed in Supabase → Authentication → URL Configuration (Redirect URLs).
# Example dev: http://localhost:5173/volunteer
# Example GitHub Pages: https://<user>.github.io/paws/volunteer
# Leave unset to auto-build from the current origin, Vite base, and /volunteer.
VITE_SUPABASE_OAUTH_REDIRECT_URL=
